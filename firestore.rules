rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 인솔교사 공용 계정만 '교사'로 인정
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'teacher@gocheon.school';
    }
    function signedIn() { return request.auth != null; }
    function myDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function validMember(d) {
      return d.keys().hasOnly(['cls','grp','name','phone','leader','ts'])
        && d.cls is int && d.cls >= 1 && d.cls <= 4
        && d.grp is int && d.grp >= 1 && d.grp <= 10
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.phone is string && d.phone.size() <= 20
        && d.leader is bool
        && d.ts == request.time;
    }

    // 학생 모둠 등록: 본인 것만 쓰기, 같은 반·같은 모둠끼리만 읽기, 교사는 전부
    match /members/{uid} {
      allow get: if isTeacher()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && resource.data.cls == myDoc().cls && resource.data.grp == myDoc().grp);
      allow list: if isTeacher()
        || (signedIn() && resource.data.cls == myDoc().cls && resource.data.grp == myDoc().grp);
      allow create, update: if signedIn() && request.auth.uid == uid && validMember(request.resource.data);
      allow delete: if isTeacher() || (signedIn() && request.auth.uid == uid);
    }

    // 모둠 보고: 학생은 보내기만, 읽기는 교사만
    match /reports/{id} {
      allow read: if isTeacher();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['cls','grp','name','kind','msg','uid','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['ok','help']
        && request.resource.data.cls is int && request.resource.data.grp is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 120
        && request.resource.data.ts == request.time;
    }

    // 모둠 사진: 작은 사진(photos)은 같은 모둠 학생과 교사가 보고, 큰 사진(photofull)은 교사만 봄
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    match /photos/{id} {
      allow get, list: if isTeacher()
        || (isMember() && resource.data.cls == myDoc().cls && resource.data.grp == myDoc().grp);
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['cls','grp','tag','cap','by','uid','th','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cls == myDoc().cls && request.resource.data.grp == myDoc().grp
        && request.resource.data.tag in ['출발','점심','도착','미션','자유']
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 40
        && request.resource.data.by is string && request.resource.data.by.size() <= 20
        && request.resource.data.th is string && request.resource.data.th.size() <= 90000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /photofull/{id} {
      allow get, list: if isTeacher();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['cls','grp','uid','img','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() <= 900000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // 모둠 채팅: 같은 모둠 학생과 교사만 읽고, 학생은 자기 이름으로 200자 이내만 쓰기. 삭제는 교사만
    match /chat/{id} {
      allow get, list: if isTeacher()
        || (isMember() && resource.data.cls == myDoc().cls && resource.data.grp == myDoc().grp);
      allow create: if (isTeacher()
          && request.resource.data.keys().hasOnly(['cls','grp','name','text','uid','ts','tc'])
          && request.resource.data.tc == true
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cls is int && request.resource.data.grp is int
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
          && request.resource.data.ts == request.time)
        || (isMember()
          && request.resource.data.keys().hasOnly(['cls','grp','name','text','uid','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cls == myDoc().cls && request.resource.data.grp == myDoc().grp
          && request.resource.data.name == myDoc().name
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
          && request.resource.data.ts == request.time);
      allow delete: if isTeacher();
    }

    // 모둠 약속(만나는 장소·시간): 같은 모둠 학생이 정해서 쓰고, 같은 모둠 학생과 교사가 읽음. 삭제는 교사만
    match /plans/{id} {
      allow get, list: if isTeacher()
        || (isMember() && resource.data.cls == myDoc().cls && resource.data.grp == myDoc().grp);
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['cls','grp','place','time','memo','by','uid','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cls == myDoc().cls && request.resource.data.grp == myDoc().grp
        && request.resource.data.by == myDoc().name
        && request.resource.data.place is string && request.resource.data.place.size() >= 1 && request.resource.data.place.size() <= 60
        && request.resource.data.time is string && request.resource.data.time.size() >= 1 && request.resource.data.time.size() <= 10
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 120
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 출결·명단·건강정보: 교사만
    match /att/{id}     { allow read, write: if isTeacher(); }
    match /private/{id} { allow read, write: if isTeacher(); }
  }
}
