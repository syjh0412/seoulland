rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 인솔교사 공용 계정만 '교사'로 인정
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'teacher@gocheon.school';
    }
    function signedIn() { return request.auth != null; }
    function validMember(d) {
      return d.keys().hasOnly(['cls','grp','name','phone','leader','ts'])
        && d.cls is int && d.cls >= 1 && d.cls <= 4
        && d.grp is int && d.grp >= 1 && d.grp <= 10
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.phone is string && d.phone.size() <= 20
        && d.leader is bool
        && d.ts == request.time;
    }

    // 2026.10.8 현장학습 종료 — 공개 페이지는 참관(보기 전용)으로 운영.
    // 학생이 쓰던 등록·채팅·사진·해시태그·보고 쓰기는 모두 교사 전용으로 닫고,
    // 다른 사람의 이름·전화번호·채팅·사진을 읽는 경로도 모두 막음(본인 것만 self-read 허용).

    // 학생 모둠 등록: 조회는 교사 또는 본인만. 새 등록·수정은 교사만(현장학습 종료로 닫음)
    match /members/{uid} {
      allow get: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow list: if isTeacher();
      allow create: if isTeacher() && validMember(request.resource.data);
      allow update: if isTeacher() && validMember(request.resource.data);
      allow delete: if isTeacher();
    }

    // 모둠 보고: 읽기는 교사만. 쓰기도 현장학습 종료로 닫음
    match /reports/{id} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','name','kind','msg','uid','ts'])
        && request.resource.data.kind in ['ok','help']
        && request.resource.data.cls is int && request.resource.data.grp is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 120
        && request.resource.data.ts == request.time;
    }

    // 모둠 사진: 조회·업로드 모두 교사만(현장학습 종료 — 같은 모둠 학생 열람 경로는 닫음)
    match /photos/{id} {
      allow get, list: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','tag','cap','by','uid','th','ts','mis'])
        && (!('mis' in request.resource.data) || (request.resource.data.mis is string && request.resource.data.mis.size() <= 40))
        && request.resource.data.tag in ['출발','점심','도착','미션','자유']
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 40
        && request.resource.data.by is string && request.resource.data.by.size() <= 20
        && request.resource.data.th is string && request.resource.data.th.size() <= 90000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }
    match /photofull/{id} {
      allow get, list: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','uid','img','ts'])
        && request.resource.data.img is string && request.resource.data.img.size() <= 900000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 모둠 채팅: 읽기·쓰기 모두 교사만(현장학습 종료 — 같은 모둠 학생 열람·전송 경로는 닫음)
    match /chat/{id} {
      allow get, list: if isTeacher();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','name','text','uid','ts','tc'])
        && request.resource.data.cls is int && request.resource.data.grp is int
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 모둠 약속: 읽기·쓰기 모두 교사만(현장학습 종료)
    match /plans/{id} {
      allow get, list: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','place','time','memo','by','uid','ts'])
        && request.resource.data.place is string && request.resource.data.place.size() >= 1 && request.resource.data.place.size() <= 60
        && request.resource.data.time is string && request.resource.data.time.size() >= 1 && request.resource.data.time.size() <= 10
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 120
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 반별 미션: 읽기는 로그인한 사용자(개인정보 아님, 참관용 보기에 필요), 쓰기는 교사만
    match /missions/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // 과학 미션(힘의 작용) 사진: 조회·업로드 모두 교사만(현장학습 종료 — 같은 반 갤러리 열람 경로는 닫음)
    match /sci/{uid} {
      allow get: if isTeacher();
      allow list: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','name','force','cap','th','uid','ts'])
        && request.resource.data.force in ['중력','탄성력','마찰력','부력','기타']
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 80
        && request.resource.data.th is string && request.resource.data.th.size() <= 90000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }
    match /scifull/{uid} {
      allow get: if isTeacher();
      allow list: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','uid','img','ts'])
        && request.resource.data.img is string && request.resource.data.img.size() <= 900000
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 오늘의 해시태그: 조회·쓰기 모두 교사만(현장학습 종료 — 같은 반 학생 열람 경로는 닫음)
    match /tags/{uid} {
      allow get: if isTeacher();
      allow list: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['cls','grp','name','tag','tags','uid','ts'])
        && request.resource.data.tag is string && request.resource.data.tag.size() >= 1 && request.resource.data.tag.size() <= 20
        && request.resource.data.tags is list && request.resource.data.tags.size() >= 1 && request.resource.data.tags.size() <= 3
        && request.resource.data.tags[0] is string && request.resource.data.tags[0].size() <= 20
        && (request.resource.data.tags.size() < 2 || (request.resource.data.tags[1] is string && request.resource.data.tags[1].size() <= 20))
        && (request.resource.data.tags.size() < 3 || (request.resource.data.tags[2] is string && request.resource.data.tags[2].size() <= 20))
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }

    // 선생님 공지: 교사가 보내고(전체·반·모둠), 로그인한 사용자는 읽기만(참관용 보기에 유지)
    match /notices/{id} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly(['scope','cls','grp','text','ts'])
        && request.resource.data.scope in ['all','cls','grp']
        && request.resource.data.cls is int && request.resource.data.grp is int
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.ts == request.time;
      allow delete: if isTeacher();
    }
    // 공지 확인: 읽기·쓰기 모두 교사만(현장학습 종료)
    match /acks/{id} {
      allow read, write: if isTeacher();
    }

    // 출결·명단·건강정보: 교사만
    match /att/{id}     { allow read, write: if isTeacher(); }
    match /private/{id} { allow read, write: if isTeacher(); }
  }
}
